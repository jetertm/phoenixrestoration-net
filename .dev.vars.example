# Copy to .dev.vars for `wrangler pages dev` only. Never commit .dev.vars.
# AGENTMAIL_API_KEY is the AgentMail API key for the phoenix-leads inbox.
# TURNSTILE_SECRET is the Turnstile widget secret from the Cloudflare dashboard.
# The public testing secret 1x0000000000000000000000000000000AA always passes.
# The quote handler rejects that testing secret on any hostname other than
# localhost and 127.0.0.1, so do not put it on the Pages project.
AGENTMAIL_API_KEY=replace-with-agentmail-api-key
TURNSTILE_SECRET=replace-with-turnstile-secret
